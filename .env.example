# Copy to .env locally. Supply your own token securely; never commit .env.
# The server does not load this automatically; use uv run --env-file .env.
JOOMLA_BASE_URL=https://example.com
BEARER_TOKEN=replace-with-your-api-token
JOOMLA_VERSION=5
JOOMLA_READ_ONLY=false
JOOMLA_ALLOW_TRUSTED_HTML=false
JOOMLA_ENABLE_USERS=false
JOOMLA_ALLOW_LOCAL_HTTP=false
JOOMLA_TIMEOUT=20
JOOMLA_READ_RETRIES=2
JOOMLA_MAX_RESPONSE_BYTES=2000000
JOOMLA_MAX_UPLOAD_BYTES=5000000
